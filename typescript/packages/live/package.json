{
  "name": "@builtbyfriends/realtime-live",
  "version": "0.9.1",
  "description": "Live queries: an RPC call plus topic subscriptions, refetched on events and reconnects. The records entry keeps one typed copy of each record, from a contract.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./records": {
      "types": "./dist/records.d.ts",
      "default": "./dist/records.js"
    },
    "./records/react": {
      "types": "./dist/records-react.d.ts",
      "default": "./dist/records-react.js"
    },
    "./records/testing": {
      "types": "./dist/records-testing.d.ts",
      "default": "./dist/records-testing.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@builtbyfriends/realtime": "0.9.1",
    "@tanstack/db": "1.0.0-rc.1.5",
    "@tanstack/react-db": "1.0.0-rc.1.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/builtbyfriends/realtime.git",
    "directory": "typescript/packages/live"
  },
  "homepage": "https://github.com/builtbyfriends/realtime#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "prepack": "cp ../../../LICENSE LICENSE"
  }
}
