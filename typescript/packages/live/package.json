{
  "name": "@builtbyfriends/realtime-live",
  "version": "0.8.1",
  "description": "Live queries: an RPC call plus topic subscriptions, refetched on events and reconnects",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@builtbyfriends/realtime": "0.8.1",
    "@tanstack/db": "1.0.0-rc.1.5",
    "@tanstack/react-db": "1.0.0-rc.1.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/builtbyfriends/realtime.git",
    "directory": "typescript/packages/live"
  },
  "homepage": "https://github.com/builtbyfriends/realtime#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "prepack": "cp ../../../LICENSE LICENSE"
  }
